# ---- Database ----
# SQLite is fine for early launch / testing. Move to Postgres (e.g. Supabase
# free tier) once you have paying customers, since most hosts wipe local
# files on redeploy and SQLite doesn't handle concurrent writers well.
DATABASE_URL=sqlite:///malita.db
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/malita

# ---- App URLs ----
# Where learners access the Streamlit app itself (used to build PayFast's
# return/cancel redirect links).
APP_BASE_URL=http://localhost:8501
# Where the separate webhook_server.py is publicly reachable (used as
# PayFast's notify_url). Must be a real public HTTPS URL once live.
APP_WEBHOOK_URL=http://localhost:8001/payfast/notify

# ---- PayFast ----
# Get these from your PayFast merchant dashboard. Use the Sandbox
# credentials below (already PayFast's published test account) until
# you've fully tested checkout + webhook end to end.
PAYFAST_MERCHANT_ID= 14006256
PAYFAST_MERCHANT_KEY=m5ne6hlhz1wak
PAYFAST_PASSPHRASE=MtnJse212535942Ukzn_Sb
PAYFAST_SANDBOX=true

# ---- Email (optional) ----
# Used for the "Forgot your password?" flow. If left unset, the app still
# works — it just shows the reset link directly on screen instead of
# emailing it, so this isn't required to get started.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=you@example.com
