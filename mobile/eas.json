{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "APP_VARIANT": "highschool" }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "env": { "APP_VARIANT": "highschool" }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": { "APP_VARIANT": "highschool" }
    },
    "development-campus": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development-campus",
      "env": { "APP_VARIANT": "campus" }
    },
    "preview-campus": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview-campus",
      "env": { "APP_VARIANT": "campus" }
    },
    "production-campus": {
      "autoIncrement": true,
      "channel": "production-campus",
      "env": { "APP_VARIANT": "campus" }
    }
  }
}